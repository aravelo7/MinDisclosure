{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindisclosure.local/schemas/planner-prototype-output-schema-v0.1.json",
  "title": "MinDisclosure Planner Prototype Structured Output v0.1",
  "description": "The only model-visible output shape. CONFIDENT and UNCERTAIN carry v0.2.1 Task IR and requirements; INVALID carries no inferred semantics.",
  "type": "object",
  "oneOf": [
    {
      "title": "CONFIDENT",
      "additionalProperties": false,
      "required": [
        "status",
        "task_ir",
        "requirements"
      ],
      "properties": {
        "status": {
          "const": "CONFIDENT"
        },
        "task_ir": {
          "$ref": "#/$defs/task_ir"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capability_requirement"
          }
        }
      }
    },
    {
      "title": "UNCERTAIN",
      "additionalProperties": false,
      "required": [
        "status",
        "task_ir",
        "requirements"
      ],
      "properties": {
        "status": {
          "const": "UNCERTAIN"
        },
        "task_ir": {
          "$ref": "#/$defs/task_ir"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capability_requirement"
          }
        }
      }
    },
    {
      "title": "INVALID",
      "additionalProperties": false,
      "required": [
        "status",
        "task_ir",
        "requirements"
      ],
      "properties": {
        "status": {
          "const": "INVALID"
        },
        "task_ir": {
          "type": "null"
        },
        "requirements": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  ],
  "$defs": {
    "field_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.\\[\\]-]*$"
    },
    "semantic_type": {
      "enum": [
        "EMAIL",
        "POSTAL_ADDRESS",
        "DATE_OF_BIRTH",
        "EVENT_TIMESTAMP",
        "PERSON_NAME",
        "RECORD_ID",
        "NUMBER",
        "INTEGER",
        "STRING",
        "TOOL_NAME",
        "TOOL_PARAMETER"
      ]
    },
    "target_role": {
      "enum": [
        "VALUE",
        "GROUP_KEY",
        "SORT_KEY",
        "LINK_KEY",
        "TEMPORAL_VALUE",
        "RELATION_SOURCE",
        "RELATION_TARGET",
        "TOOL_ARGUMENT"
      ]
    },
    "operation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_ref",
        "semantic_type",
        "target_role"
      ],
      "properties": {
        "field_ref": {
          "$ref": "#/$defs/field_ref"
        },
        "semantic_type": {
          "$ref": "#/$defs/semantic_type"
        },
        "target_role": {
          "$ref": "#/$defs/target_role"
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "HOUR",
            "DAY"
          ]
        }
      }
    },
    "semantic_parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "ASCENDING",
            "DESCENDING"
          ]
        },
        "precision": {
          "enum": [
            "YEAR",
            "DAY",
            "HOUR",
            "EXACT"
          ]
        },
        "granularity": {
          "enum": [
            "EMAIL_DOMAIN",
            "YEAR",
            "DAY",
            "HOUR",
            "REGION",
            "SERVICE_ZONE",
            "EXACT"
          ]
        },
        "comparison": {
          "enum": [
            "EQUAL",
            "ABSOLUTE_DIFFERENCE_LEQ"
          ]
        },
        "threshold": {
          "$ref": "#/$defs/threshold"
        },
        "interval_semantics": {
          "enum": [
            "CLOSED",
            "OPEN",
            "LEFT_CLOSED",
            "RIGHT_CLOSED"
          ]
        },
        "equality_basis": {
          "enum": [
            "FIELD_VALUE",
            "ENTITY_IDENTITY"
          ]
        },
        "stability_scope": {
          "enum": [
            "TASK"
          ]
        },
        "linkage_scope": {
          "enum": [
            "TASK",
            "CROSS_RECORD"
          ]
        },
        "relation_orientation": {
          "enum": [
            "DIRECTED",
            "UNDIRECTED"
          ]
        },
        "relation_source": {
          "const": "SOURCE_DECLARED"
        },
        "zone_rule_ref": {
          "type": "string",
          "pattern": "^workflow\\.[a-z][a-z0-9_.-]*$"
        },
        "region_scheme_ref": {
          "type": "string",
          "pattern": "^workflow\\.[a-z][a-z0-9_.-]*$"
        },
        "category_system_ref": {
          "type": "string",
          "pattern": "^(workflow|schema)\\.[a-z][a-z0-9_.-]*$"
        },
        "set_ref": {
          "type": "string",
          "pattern": "^(workflow|schema)\\.[a-z][a-z0-9_.-]*$"
        },
        "aggregation": {
          "enum": [
            "SUM",
            "COUNT",
            "COUNT_AND_SUM",
            "MAXIMUM"
          ]
        },
        "workflow_order_ref": {
          "type": "string",
          "pattern": "^workflow\\.[a-z][a-z0-9_.-]*$"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "family",
        "role",
        "inputs",
        "parameters",
        "depends_on",
        "result_shape"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^op\\.[a-z][a-z0-9_.-]*$"
        },
        "family": {
          "enum": [
            "equality",
            "deduplicate",
            "group_by",
            "aggregate",
            "sort",
            "filter",
            "compare",
            "temporal_window",
            "record_linkage",
            "graph_relation",
            "degree",
            "reachability",
            "select",
            "tool_call"
          ]
        },
        "role": {
          "enum": [
            "AGENT_REASONING",
            "TOOL_EXECUTION"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation_input"
          }
        },
        "parameters": {
          "$ref": "#/$defs/semantic_parameters"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^op\\.[a-z][a-z0-9_.-]*$"
          }
        },
        "result_shape": {
          "enum": [
            "groups",
            "ordered_records",
            "record_pairs",
            "source_graph",
            "graph_summary",
            "aggregate_table",
            "selected_record",
            "tool_call",
            "task_result"
          ]
        },
        "tool_ref": {
          "type": "string",
          "pattern": "^tool\\.[a-z][a-z0-9_.-]*$"
        },
        "tool_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter_ref",
              "name",
              "semantic_type",
              "source_field_ref"
            ],
            "properties": {
              "parameter_ref": {
                "type": "string",
                "pattern": "^tool\\.[a-z][a-z0-9_.-]*$"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "semantic_type": {
                "$ref": "#/$defs/semantic_type"
              },
              "source_field_ref": {
                "$ref": "#/$defs/field_ref"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "tool_call"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "required": [
              "tool_ref",
              "tool_parameters"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "tool_ref"
                  ]
                },
                {
                  "required": [
                    "tool_parameters"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "TOOL_EXECUTION"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "family": {
                "const": "tool_call"
              }
            }
          }
        }
      ]
    },
    "presentation_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "kind",
        "authority",
        "scope",
        "rule"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "pattern": "^presentation\\.[a-z][a-z0-9_.-]*$"
        },
        "kind": {
          "enum": [
            "semantic_order",
            "identifier_assignment",
            "label_convention",
            "serialization_guard"
          ]
        },
        "authority": {
          "enum": [
            "USER_INTENT",
            "TRUSTED_WORKFLOW",
            "DATA_SCHEMA",
            "TOOL_SCHEMA"
          ]
        },
        "scope": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "rule": {
          "enum": [
            "INPUT_ORDER",
            "SOURCE_APPEARANCE_ORDER",
            "ENDPOINT_APPEARANCE_ORDER",
            "WORKFLOW_DECLARED_ORDER",
            "DECLARED_PARAMETER_NAMES",
            "IGNORE_JSON_KEY_ORDER"
          ]
        }
      }
    },
    "task_ir": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_ir_version",
        "operations",
        "presentation"
      ],
      "properties": {
        "task_ir_version": {
          "const": "task-ir-v0.2"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "presentation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/presentation_constraint"
          }
        }
      }
    },
    "capability_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_ref",
        "semantic_type",
        "target_role"
      ],
      "properties": {
        "field_ref": {
          "$ref": "#/$defs/field_ref"
        },
        "semantic_type": {
          "$ref": "#/$defs/semantic_type"
        },
        "target_role": {
          "$ref": "#/$defs/target_role"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "name",
        "parameters"
      ],
      "properties": {
        "family": {
          "enum": [
            "identity",
            "property",
            "relation",
            "exact_value"
          ]
        },
        "name": {
          "enum": [
            "identity",
            "equality",
            "linkage",
            "domain",
            "category",
            "ordering",
            "coarse_temporal",
            "geographic_region",
            "service_zone",
            "existing_relation",
            "membership",
            "directionality",
            "temporal_comparison",
            "exact_value"
          ]
        },
        "parameters": {
          "$ref": "#/$defs/semantic_parameters"
        }
      },
      "oneOf": [
        {
          "properties": {
            "family": {
              "const": "identity"
            },
            "name": {
              "enum": [
                "identity",
                "equality",
                "linkage"
              ]
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "property"
            },
            "name": {
              "enum": [
                "domain",
                "category",
                "ordering",
                "coarse_temporal",
                "geographic_region",
                "service_zone"
              ]
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "relation"
            },
            "name": {
              "enum": [
                "existing_relation",
                "membership",
                "directionality",
                "temporal_comparison"
              ]
            }
          }
        },
        {
          "properties": {
            "family": {
              "const": "exact_value"
            },
            "name": {
              "const": "exact_value"
            }
          }
        }
      ]
    },
    "requirement_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ALL_OCCURRENCES",
            "ALL_RECORDS",
            "DECLARED_RELATION_SET",
            "DECLARED_TOOL_ARGUMENT"
          ]
        },
        "reference": {
          "type": "string",
          "pattern": "^(relation|tool)\\.[a-z][a-z0-9_.-]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "DECLARED_RELATION_SET",
                  "DECLARED_TOOL_ARGUMENT"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "reference"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reference"
              ]
            }
          }
        }
      ]
    },
    "authority_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "authority_class",
        "support_type",
        "support_ref"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^ctx\\.[a-z][a-z0-9_.-]*$"
        },
        "authority_class": {
          "enum": [
            "USER_INTENT",
            "TRUSTED_WORKFLOW",
            "DATA_SCHEMA",
            "TOOL_SCHEMA"
          ]
        },
        "support_type": {
          "enum": [
            "OPERATION",
            "WORKFLOW_RULE",
            "SCHEMA_FIELD",
            "SOURCE_RELATION",
            "TOOL_PARAMETER"
          ]
        },
        "support_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      }
    },
    "capability_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "operation_ref",
        "targets",
        "capability",
        "scope",
        "boundary",
        "authority_witness"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^req\\.[a-z][a-z0-9_.-]*$"
        },
        "operation_ref": {
          "type": "string",
          "pattern": "^op\\.[a-z][a-z0-9_.-]*$"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability_target"
          }
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "scope": {
          "$ref": "#/$defs/requirement_scope"
        },
        "boundary": {
          "enum": [
            "AGENT",
            "TOOL"
          ]
        },
        "authority_witness": {
          "$ref": "#/$defs/authority_witness"
        }
      }
    },
    "capability_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_ir_version",
        "requirements"
      ],
      "properties": {
        "capability_ir_version": {
          "const": "information-capability-ir-v0.2"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capability_requirement"
          }
        }
      }
    }
  }
}
