{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindisclosure.local/schemas/planner-capability-schema-v0.1.json",
  "title": "MinDisclosure Planner Task IR and Capability Requirements",
  "description": "Planner output only; it contains semantic requirements and no task answer or disclosure representation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_ir",
    "capability_requirements",
    "uncertainty"
  ],
  "properties": {
    "schema_version": {
      "const": "planner-capability-schema-v0.1"
    },
    "task_ir": {
      "$ref": "#/$defs/task_ir"
    },
    "capability_requirements": {
      "$ref": "#/$defs/capability_requirements"
    },
    "uncertainty": {
      "enum": [
        "CONFIDENT",
        "UNCERTAIN",
        "INVALID"
      ]
    }
  },
  "$defs": {
    "field_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.\\[\\]-]*$"
    },
    "semantic_type": {
      "type": "string",
      "enum": [
        "EMAIL",
        "POSTAL_ADDRESS",
        "DATE_OF_BIRTH",
        "EVENT_TIMESTAMP",
        "PERSON_NAME",
        "RECORD_ID",
        "NUMBER",
        "INTEGER",
        "STRING",
        "TOOL_NAME",
        "TOOL_PARAMETER"
      ]
    },
    "operation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_ref",
        "semantic_type"
      ],
      "properties": {
        "field_ref": {
          "$ref": "#/$defs/field_ref"
        },
        "semantic_type": {
          "$ref": "#/$defs/semantic_type"
        }
      }
    },
    "operation_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "property",
            "relation",
            "comparison",
            "ordering",
            "aggregation",
            "selection"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "family",
        "role",
        "inputs",
        "uses",
        "result_shape"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^op\\.[a-z][a-z0-9_.-]*$"
        },
        "family": {
          "enum": [
            "equality",
            "deduplicate",
            "group_by",
            "aggregate",
            "sort",
            "filter",
            "compare",
            "temporal_window",
            "record_linkage",
            "graph_relation",
            "degree",
            "reachability",
            "select",
            "tool_call"
          ]
        },
        "role": {
          "enum": [
            "AGENT_REASONING",
            "TOOL_EXECUTION"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation_input"
          }
        },
        "uses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation_use"
          }
        },
        "result_shape": {
          "enum": [
            "groups",
            "ordered_records",
            "record_pairs",
            "graph_summary",
            "aggregate_table",
            "selected_record",
            "tool_call",
            "task_result"
          ]
        },
        "tool_ref": {
          "type": "string",
          "pattern": "^tool\\.[a-z][a-z0-9_.-]*$"
        },
        "tool_parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "semantic_type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "semantic_type": {
                "$ref": "#/$defs/semantic_type"
              }
            }
          }
        }
      }
    },
    "presentation_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "kind",
        "authority",
        "rule"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "pattern": "^presentation\\.[a-z][a-z0-9_.-]*$"
        },
        "kind": {
          "enum": [
            "semantic_order",
            "identifier_assignment",
            "label_convention",
            "serialization_guard"
          ]
        },
        "authority": {
          "enum": [
            "USER_INTENT",
            "TRUSTED_WORKFLOW",
            "DATA_SCHEMA",
            "TOOL_SCHEMA"
          ]
        },
        "scope": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "rule": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      }
    },
    "task_ir": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_ir_version",
        "operations",
        "presentation"
      ],
      "properties": {
        "task_ir_version": {
          "const": "task-ir-v0.1"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "presentation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/presentation_constraint"
          }
        }
      }
    },
    "capability_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_ref",
        "semantic_type"
      ],
      "properties": {
        "field_ref": {
          "$ref": "#/$defs/field_ref"
        },
        "semantic_type": {
          "$ref": "#/$defs/semantic_type"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "name"
      ],
      "oneOf": [
        {
          "properties": {
            "family": {"const": "identity"},
            "name": {"enum": ["identity", "equality", "linkage"]}
          }
        },
        {
          "properties": {
            "family": {"const": "property"},
            "name": {"enum": ["domain", "category", "ordering", "coarse_temporal", "geographic_region", "service_zone"]}
          }
        },
        {
          "properties": {
            "family": {"const": "relation"},
            "name": {"enum": ["existing_relation", "membership", "directionality", "temporal_comparison"]}
          }
        },
        {
          "properties": {
            "family": {"const": "exact_value"},
            "name": {"const": "exact_value"}
          }
        }
      ],
      "properties": {
        "family": {
          "enum": [
            "identity",
            "property",
            "relation",
            "exact_value"
          ]
        },
        "name": {
          "enum": [
            "identity",
            "equality",
            "linkage",
            "domain",
            "category",
            "ordering",
            "coarse_temporal",
            "geographic_region",
            "service_zone",
            "existing_relation",
            "membership",
            "directionality",
            "temporal_comparison",
            "exact_value"
          ]
        }
      }
    },
    "capability_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "targets",
        "capability",
        "boundary",
        "purpose",
        "exact_value_required",
        "scope",
        "authority"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^req\\.[a-z][a-z0-9_.-]*$"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capability_target"
          }
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "boundary": {
          "enum": [
            "AGENT",
            "TOOL"
          ]
        },
        "purpose": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "exact_value_required": {
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "all_occurrences",
            "all_records",
            "declared_relation_set",
            "declared_tool_argument"
          ]
        },
        "authority": {
          "enum": [
            "USER_INTENT",
            "TRUSTED_WORKFLOW",
            "DATA_SCHEMA",
            "TOOL_SCHEMA"
          ]
        }
      }
    },
    "capability_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_ir_version",
        "requirements"
      ],
      "properties": {
        "capability_ir_version": {
          "const": "information-capability-ir-v0.1"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capability_requirement"
          }
        }
      }
    }
  }
}
